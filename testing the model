import pandas as pd
import numpy as np
import joblib
import os
from pathlib import Path
from tabulate import tabulate
from colorama import Fore, Style, init
from utilities import clean_numeric, scale_midsem_to_endsem

init(autoreset=True)

DATA_CSV = "cleaned_dataset.csv"
# Updated to match the new config
SUBJECTS = ["Math", "ECE", "Clanguage", "EG"]

def load_models():
    models = {}
    for subj in SUBJECTS:
        model_file = f"{subj}_grade_model.pkl"
        if Path(model_file).exists():
            models[subj] = joblib.load(model_file)
    return models

def predict_for_student(roll, subject, models):
    if subject not in models:
        print(Fore.RED + f"Error: No model found for {subject}.")
        return

    df = pd.read_csv(DATA_CSV)
    # Robust string comparison for Roll Number 
    row = df[df["RollNo"].astype(str) == str(roll)]

    if row.empty:
        print(Fore.RED + f"No data found for Roll No: {roll}")
        return

    model_data = models[subject]
    model = model_data["model"]
    trained_features = model_data["features"]

    # Reconstruct features exactly as they were during training [cite: 9]
    input_data = {}
    for f in trained_features:
        if f in row.columns:
            input_data[f] = clean_numeric(row.iloc[0][f])
        elif f == "Attendance_num":
            from utilities import attendance_to_num
            input_data[f] = attendance_to_num(row.iloc[0]["Attendance"])
        else:
            input_data[f] = 0 # Default for one-hot columns not present for this student

    x = pd.DataFrame([input_data])[trained_features]
    pred = model.predict(x)[0]
    
    print("\n" + "═"*45)
    print(f" Subject: {Fore.YELLOW}{subject}")
    print(f" Predicted Grade: {Fore.GREEN}{Style.BRIGHT}{pred}")
    print("═"*45)

def main():
    models = load_models()
    if not models:
        print(Fore.RED + "No models found. Run train_model.py first.")
        return

    roll = input("Enter Roll Number: ").strip()
    print(f"Available Subjects: {', '.join(models.keys())}")
    subject = input("Enter Subject: ").strip()
    
    # Simple normalization for input
    if subject.lower() == "math": subject = "Math"
    if subject.lower() == "ece": subject = "ECE"
    
    predict_for_student(roll, subject, models)

if __name__ == "__main__":
    main()
